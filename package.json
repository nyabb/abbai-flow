{
  "name": "abbai-flow",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Abbai Flow — a family organisation and gamification platform: routines, missions, chores, rewards and everyday family life, with a Home Assistant add-on and a standalone server.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.scripts.json && npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc && tsc -p tsconfig.scripts.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "pretest:server": "npm run build:server",
    "test:server": "node --test server/__tests__/app.test.cjs",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:server && npm run test:e2e",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "start": "node server/main.cjs",
    "serve": "vite build && npx serve dist -l 3000"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "date-fns": "^4.1.0",
    "gridstack": "^13.2.0",
    "lucide-react": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.3",
    "sharp": "^0.35.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.0",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nyabb/abbai-flow.git"
  },
  "homepage": "https://github.com/nyabb/abbai-flow#readme",
  "bugs": {
    "url": "https://github.com/nyabb/abbai-flow/issues"
  }
}
