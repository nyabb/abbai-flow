{
  "// why": "The server runtime image has no package.json, so the existing CommonJS server remains the runtime host. This config compiles the shared planner, Encore, Spotify catalog, playlist OAuth and integration diagnostics TypeScript modules into server/build for server/app.cjs to load.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "rootDir": "src/api",
    "outDir": "server/build",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": []
  },
  "files": [
    "src/api/planner-rules.ts",
    "src/api/bluetooth-types.ts",
    "src/api/bluetooth-manager.ts",
    "src/api/bluetooth-http.ts",
    "src/api/bluetooth-runtime.ts",
    "src/api/encore-http.ts",
    "src/api/encore-music.ts",
    "src/api/spotify-catalog.ts",
    "src/api/spotify-playlists.ts",
    "src/api/integration-diagnostics.ts",
    "src/api/ws.d.ts"
  ]
}
