{
  "// why": "The server runtime image has no package.json, so the existing CommonJS server remains the runtime host. This config compiles the shared planner rules and Encore modules from TypeScript into server/build for server/app.cjs to load.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "rootDir": "src/api",
    "outDir": "server/build",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": []
  },
  "files": [
    "src/api/planner-rules.ts",
    "src/api/encore-http.ts",
    "src/api/encore-music.ts",
    "src/api/ws.d.ts"
  ]
}
